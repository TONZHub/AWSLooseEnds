{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "LooseEnds",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "LooseEnds"
  },
  "runtimes": [
    {
      "name": "LooseEnds",
      "description": "Promise Pocket: a quiet memory for commitments that interrupts only when human attention is required.",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/PromisePocket",
      "runtimeVersion": "PYTHON_3_12",
      "protocol": "HTTP",
      "networkMode": "PUBLIC",
      "authorizerType": "AWS_IAM",
      "instrumentation": {
        "enableOtel": true
      },
      "envVars": [
        {
          "name": "MODEL_ID",
          "value": "us.anthropic.claude-sonnet-4-6"
        },
        {
          "name": "LOOSE_ENDS_TABLE",
          "value": "loose-ends-commitments"
        }
      ],
      "additionalPolicies": [
        "arn:aws:iam::568608118800:policy/loose-ends-commitments-runtime"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
