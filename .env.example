# AgentCore CLI sets LOCAL_DEV=1 when using `agentcore dev`.
LOCAL_DEV=1

# Local development only. Deployed runtimes must use LOOSE_ENDS_TABLE.
LOOSE_ENDS_LOCAL_PATH=.data/commitments.json
LOOSE_ENDS_DEV_ACTOR=local-user
LOOSE_ENDS_TIMEZONE=America/New_York

# Set these after provisioning AWS infrastructure.
# LOOSE_ENDS_TABLE=loose-ends-commitments
# AWS_REGION=us-east-1

# Optional Bedrock model override.
MODEL_ID=us.amazon.nova-lite-v1:0
